# OXACAN mobile app configuration. Copy to apps/mobile/.env (not committed).
# Expo inlines EXPO_PUBLIC_* values into the app bundle, so everything here is
# PUBLIC. Never put the Supabase service-role key or other secrets in this file.

# OXACAN API base URL (no trailing slash). On a physical device use your
# machine's LAN IP instead of localhost, e.g. http://192.168.1.20:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# Supabase project URL. Can point at a proxy when *.supabase.co is blocked
# on the network (e.g. the API's dev auth proxy).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public anon key (safe to ship in the app; RLS applies).
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
