// OXACAN — modèle de données. Multi-tenant par colonne tenantId + RLS (voir migration).
// Montants : entiers en centimes CHF. Quantités : Decimal(12,3).

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DIRIGEANT
  CHEF_PROJET
  TECHNICIEN
  CLIENT
}
enum OfferStatus {
  PREPARATION
  ENVOYEE
  NEGOCIATION
  ADJUGEE
  PERDUE
}
enum ArticleKind {
  CATALOGUE
  COMPOSED
  CUSTOM
}
enum ProjectStatus {
  PLANIFIE
  EN_COURS
  TERMINE
}
enum TaskStatus {
  A_FAIRE
  EN_COURS
  TERMINE
}
enum InvoiceKind {
  ACOMPTE
  SITUATION
  FINALE
  AVOIR
  ONE_SHOT
}
enum InvoiceStatus {
  EN_PREPARATION
  ENVOYEE
  ENCAISSEE
  ECHUE
  ANNULEE
}

model Tenant {
  id            String   @id @default(uuid())
  name          String
  /// Facteur de vente par défaut (Q23) et taux horaire (centimes) pour les budgets d'heures.
  sellFactor    Decimal  @default(1.2) @db.Decimal(6, 3)
  hourlyRate    Int      @default(9500)
  vatRate       Decimal  @default(8.1) @db.Decimal(5, 2)
  createdAt     DateTime @default(now())
  users         User[]
  catalogue     CatalogueItem[]
  composed      ComposedArticle[]
  offers        Offer[]
  projects      Project[]
  invoices      Invoice[]
  sequences     DocumentSequence[]
  audit         AuditLog[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  fullName     String
  role         Role
  language     String   @default("fr")
  createdAt    DateTime @default(now())
  @@unique([tenantId, email])
  @@index([tenantId])
}

/// Position de catalogue importée par l'entreprise (CSV + mapping). Jamais fournie par OXACAN.
model CatalogueItem {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  label       String
  unit        String
  chapter     String?
  material    Int      @default(0)
  labour      Int      @default(0)
  subcontract Int      @default(0)
  importedAt  DateTime @default(now())
  @@unique([tenantId, code])
  @@index([tenantId, chapter])
}

model ComposedArticle {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  label       String
  unit        String
  components  ComposedComponent[]
  @@unique([tenantId, code])
}

model ComposedComponent {
  id          String @id @default(uuid())
  composedId  String
  composed    ComposedArticle @relation(fields: [composedId], references: [id], onDelete: Cascade)
  catalogueCode String
  quantity    Decimal @db.Decimal(12, 3)
}

model Offer {
  id              String      @id @default(uuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reference       String
  clientName      String
  title           String
  status          OfferStatus @default(PREPARATION)
  version         Int         @default(1)
  sellFactor      Decimal     @db.Decimal(6, 3)
  vatRate         Decimal     @db.Decimal(5, 2)
  discountPercent Decimal     @default(0) @db.Decimal(5, 2)
  zones           Zone[]
  project         Project?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  @@unique([tenantId, reference])
  @@index([tenantId, status])
}

model Zone {
  id       String    @id @default(uuid())
  offerId  String
  offer    Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  position Int
  label    String
  cfcs     Cfc[]
}

model Cfc {
  id       String    @id @default(uuid())
  zoneId   String
  zone     Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  position Int
  code     String
  label    String
  chapters Chapter[]
}

model Chapter {
  id       String      @id @default(uuid())
  cfcId    String
  cfc      Cfc         @relation(fields: [cfcId], references: [id], onDelete: Cascade)
  position Int
  code     String
  label    String
  lines    OfferLine[]
}

model OfferLine {
  id             String      @id @default(uuid())
  chapterId      String
  chapter        Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  position       Int
  kind           ArticleKind
  code           String
  label          String
  unit           String
  quantity       Decimal     @db.Decimal(12, 3)
  material       Int         @default(0)
  labour         Int         @default(0)
  subcontract    Int         @default(0)
  factorOverride Decimal?    @db.Decimal(6, 3)
  excluded       Boolean     @default(false)
  executed       Decimal     @default(0) @db.Decimal(12, 3)
  tasks          Task[]
}

model Project {
  id        String        @id @default(uuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offerId   String        @unique
  offer     Offer         @relation(fields: [offerId], references: [id])
  name      String
  status    ProjectStatus @default(PLANIFIE)
  lots      WorkLot[]
  situations Situation[]
  createdAt DateTime      @default(now())
  @@index([tenantId, status])
}

/// Lot de travail = regroupement des postes par zone/chapitre (Q34). Devient un jeu de tâches chantier.
model WorkLot {
  id                 String  @id @default(uuid())
  projectId          String
  project            Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  zoneLabel          String
  chapterCode        String
  chapterLabel       String
  budgetLabourCents  Int
  budgetHours        Decimal @db.Decimal(10, 2)
  budgetMaterialCents Int
  tasks              Task[]
}

model Task {
  id        String     @id @default(uuid())
  lotId     String
  lot       WorkLot    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  lineId    String?
  line      OfferLine? @relation(fields: [lineId], references: [id])
  title     String
  status    TaskStatus @default(A_FAIRE)
  hoursDone Decimal    @default(0) @db.Decimal(10, 2)
}

model Situation {
  id                    String   @id @default(uuid())
  projectId             String
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number                Int
  cumulativeExclVat     Int
  periodExclVat         Int
  retentionThisPeriod   Int
  depositsDeducted      Int
  netExclVat            Int
  vatAmount             Int
  netInclVat            Int
  snapshot              Json
  invoice               Invoice?
  createdAt             DateTime @default(now())
  @@unique([projectId, number])
}

/// Numérotation continue par tenant, par type et par année (Q20).
model DocumentSequence {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind     String
  year     Int
  last     Int    @default(0)
  @@id([tenantId, kind, year])
}

model Invoice {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number       String
  kind         InvoiceKind
  status       InvoiceStatus @default(EN_PREPARATION)
  situationId  String?       @unique
  situation    Situation?    @relation(fields: [situationId], references: [id])
  /// Pour un avoir : facture corrigée.
  correctsId   String?
  corrects     Invoice?      @relation("Correction", fields: [correctsId], references: [id])
  correctedBy  Invoice[]     @relation("Correction")
  totalExclVat Int
  vatAmount    Int
  totalInclVat Int
  issuedAt     DateTime      @default(now())
  dueAt        DateTime?
  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  action    String
  entity    String
  entityId  String
  at        DateTime @default(now())
  @@index([tenantId, at])
}
