{
	admin off
	auto_https off
	servers {
		# Railway's edge is the only peer of this server; it connects from its internal range
		# 100.64.0.0/10 (or a private range) and puts the client's address in X-Forwarded-For.
		# Trusting it makes reverse_proxy forward that header with the edge appended, instead of
		# replacing it with the edge's address (which put every client in one API rate-limit
		# bucket). Strict: the client IP is read right to left, so a client cannot spoof it by
		# sending its own X-Forwarded-For. The API trusts the same ranges (trust-proxy.ts).
		trusted_proxies static private_ranges 100.64.0.0/10
		trusted_proxies_strict
	}
}

:{$PORT:3000} {
	encode zstd gzip

	# Same-origin API: no CORS, and the API stays on Railway's private network.
	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM}
	}

	# Supabase Auth through our own domain, for networks that block *.supabase.co.
	handle_path /supabase/* {
		reverse_proxy {$SUPABASE_URL} {
			header_up Host {upstream_hostport}
		}
	}

	handle {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		# HTTPS only for a year (Railway terminates TLS in front of this server).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The bundle is same-origin with no inline scripts or eval; Supabase is reached through
		# /supabase, the direct host is allowed for when the proxy is switched off.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), payment=(), usb=()"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
