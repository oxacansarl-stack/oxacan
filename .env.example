# ============================================
# OXACAN - Environment Variables Template
# ============================================
# Copy this file to .env and fill in real values
# ============================================

# --- App ---
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (decomposed for TypeORM — avoids URL-parsing issues) ---
DB_HOST=db.your-project.supabase.co
DB_PORT=5432
# API connects as a non-superuser role so RLS applies (create it with scripts/db/app-role.sql)
DB_USERNAME=oxacan_app
DB_PASSWORD=your-app-role-password
DB_NAME=postgres
# Schema owner, used only for migrations and app-role setup
DB_MIGRATION_USERNAME=postgres
DB_MIGRATION_PASSWORD=your-db-password

# --- Sentry ---
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# --- PostHog ---
POSTHOG_API_KEY=your-posthog-key
POSTHOG_HOST=https://eu.posthog.com

# --- Resend ---
RESEND_API_KEY=your-resend-key
RESEND_FROM=onboarding@resend.dev

# --- JWT ---
# Real logins are Supabase session tokens, verified against SUPABASE_URL's JWKS.
# JWT_SECRET only signs local dev tokens (npm run db:seed), accepted when ALLOW_DEV_TOKENS=true
# and NODE_ENV is not production. Never enable dev tokens on a deployed environment.
JWT_SECRET=change-me-in-production

# Signs the database RLS context (company/user/bypass) so a SQL injection cannot switch company.
# Random, at least 32 characters; run-migrations / predeploy store it in the database. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RLS_CONTEXT_SECRET=
JWT_EXPIRATION=3600
ALLOW_DEV_TOKENS=false
